```
-- | The **Hoare** module defines Iris-style Hoare triples on top of the weakest
-- | precondition calculus, together with the basic structural rules for them.
-- |
-- | Following Iris, a Hoare triple `{P} e {Phi}` is *not* primitive: it is defined
-- | as the persistent magic wand `□ (P -∗ wp e {Phi})`. The persistence modality
-- | makes triples duplicable (they may be used arbitrarily often, as specifications
-- | should be), and the wand reduces reasoning about triples to reasoning about
-- | weakest preconditions (`wp`) from `weakestpre`. All predicates live in the
-- | proper-uPred model `ProperUPred` over the heap resource algebra
-- | `HeapCMRA Loc cnt Value` (a `gmap`-based CMRA with exclusive cell ownership).
-- |
-- | Contents: the triple `ht`, and the rule of consequence `ht_conseq`.

\import Paths
\import interface
\import lang
\import Paths
\import uPred
\import cmra
\import weakestpre
\import lib.heap
\import lib.gmap_cmra
\import lib.excl_cmra

-- =================================================================================
-- Hoare triples
-- =================================================================================

-- | The Iris Hoare triple `{P} e {Phi}`, defined as the persistent wand
-- | `□ (P -∗ wp e {Phi})`. Intuitively: persistently, given the precondition `P`,
-- | executing `e` is safe and any resulting value `v` satisfies the postcondition
-- | `Phi v`. Persistence (`mkProperPersistently`) makes the spec freely duplicable;
-- | the wand (`mkProperWand`) threads `P`'s resources into the weakest precondition.
\func ht
  {cnt : Countable Loc}
  (P   : ProperUPred (HeapCMRA Loc cnt Value))
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : ProperUPred (HeapCMRA Loc cnt Value)
  => mkProperPersistently (mkProperWand P (wp e Phi))


-- =================================================================================
-- Hoare-triple rules
-- =================================================================================


-- | Rule of consequence for Hoare triples: a triple may be strengthened in its
-- | precondition and weakened in its postcondition. Given `P' ⊢ P` and
-- | `Phi v ⊢ Phi' v` for all `v`, it derives `{P} e {Phi} ⊢ {P'} e {Phi'}`.
-- |
-- | Proof idea: unfold both triples to persistent wands. At step-index `n` with the
-- | given persistent witness, pick any later index/resource `a'` satisfying the new
-- | precondition `P'`. Using `cmra_validN_op_l` we extract validity of `a'`, apply
-- | the hypothesis `hP` to get `P a'`, feed it through the original wand to obtain
-- | `wp e {Phi}` on `b · a'`, and finally push the postcondition weakening with
-- | `wp_post_mono` to conclude `wp e {Phi'}`.
\lemma ht_conseq
  {cnt : Countable Loc}
  (P P' : ProperUPred (HeapCMRA Loc cnt Value))
  (e    : Expr)
  (Phi Phi' : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (hP   : properUPred_ent P' P)
  (hPhi : \Pi (v : Value) -> properUPred_ent (Phi v) (Phi' v))
  : properUPred_ent (ht P e Phi) (ht P' e Phi')
  =>
    \let M => HeapCMRA Loc cnt Value
    \in \lam n a hv h_pers =>
        \lam m m_le_n b unit_incl_b =>
            \lam k k_le_m a' hv_b_a' hP'_a' =>
                \let
                  | hv_a' : M.validN k a' =>
                    M.cmra_validN_op_l k a' b
                        (transport (\lam w => M.validN k w) (M.cmra_comm b a') hv_b_a')
                  | hP_a' : P.upred_holds k a' => hP k a' hv_a' hP'_a'
                  | hwand : (mkProperWand P (wp e Phi)).upred_holds m b =>
                    h_pers m m_le_n b unit_incl_b
                  | h_wp_b_a' : (wp e Phi).upred_holds k (M.op b a') =>
                    hwand k k_le_m a' hv_b_a' hP_a'
                \in wp_post_mono e Phi Phi' hPhi k (M.op b a') hv_b_a' h_wp_b_a'
```
