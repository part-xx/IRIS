-- =================================================================================
-- BUpd laws
-- =================================================================================


-- \record BUpdNE {cnt : Countable Loc}
--   | bupd       : ProperUPred (HeapCMRA Loc cnt Value) -> ProperUPred (HeapCMRA Loc cnt Value)
--   | bupd_ne    : \Pi (n : Nat) (P Q : ProperUPred (HeapCMRA Loc cnt Value)) ->
--       upredDist n P Q -> upredDist n (bupd P) (bupd Q)
--   | bupd_mono  : \Pi (P Q : ProperUPred (HeapCMRA Loc cnt Value)) ->
--       properUPred_ent P Q -> properUPred_ent (bupd P) (bupd Q)
--   | bupd_trans : \Pi (P : ProperUPred (HeapCMRA Loc cnt Value)) ->
--       properUPred_ent (bupd (bupd P)) (bupd P)
--   | bupd_intro : \Pi (P : ProperUPred (HeapCMRA Loc cnt Value)) ->
--       properUPred_ent P (bupd P)
--   | bupd_frame_r : \Pi (P R : ProperUPred (HeapCMRA Loc cnt Value)) ->
--       properUPred_ent (mkProperSep (bupd P) R) (bupd (mkProperSep P R))
--   | bupd_extract_pure : \Pi (phi : \Prop) (n : Nat) (a : (HeapCMRA Loc cnt Value).E) ->
--       validN {HeapCMRA Loc cnt Value} n a ->
--           (bupd (mkProperPure phi)).upred_holds n a -> phi
--   | bupd_later_iter_soundness :
--   \Pi (k : Nat) (phi : \Prop) (a : (HeapCMRA Loc cnt Value).E) ->
--       validN {HeapCMRA Loc cnt Value} k a ->
--           (bupd_later_iter_fn bupd k (bupd (mkProperPure phi))).upred_holds k a -> phi



-- | Builds the iterated modality `(|==> ▷)^k (|==> ⌜φ⌝)` used in Iris adequacy.
-- | Starting from `P`, each step wraps the predicate in a `later` and then a basic
-- | update: `k = 0` is `P`, and `suc k` is `mkProperBUpd (mkProperLater (... k ...))`.
-- | This is the shape produced by running `k` program steps in the soundness proof.
\func bupd_later_iter_fn {M : UCMRA}
                         (k : Nat)
                         (P : ProperUPred M)
  : ProperUPred M \elim k
  | 0     => P
  | suc k => mkProperBUpd (mkProperLater (bupd_later_iter_fn k P))

-- | Non-expansiveness of `bupd` on `uPred(M)`: if `P` and `Q` are `n`-equal then so
-- | are `|==> P` and `|==> Q`. Proven by unfolding `mkProperBUpd` on both directions
-- | and transporting the witness `a'` through `P`/`Q` `n`-equality, using that the
-- | left operand of a valid composite is valid (`cmra_validN_op_l`).
\lemma bupd_ne {M : UCMRA} (n : Nat) (P Q : ProperUPred M)
  : upredDist n P Q -> upredDist n (mkProperBUpd P) (mkProperBUpd Q) =>
  \lam hPQ m a m_le_n hv_a =>
      (\lam hP k k_le_m yf hv_op =>
           \case hP k k_le_m yf hv_op \with {
             | inP (a', hv'_op, hp_a') =>
               \let
                 | k_le_n : k <= n => NatSemiring.<=∘ k_le_m m_le_n
                 | hv_a' : M.validN k a' => M.cmra_validN_op_l k a' yf hv'_op
                 | hq_a' : Q.upred_holds k a' => (hPQ k a' k_le_n hv_a').1 hp_a'
               \in inP (a', hv'_op, hq_a')
           },
       \lam hQ k k_le_m yf hv_op =>
           \case hQ k k_le_m yf hv_op \with {
             | inP (a', hv'_op, hq_a') =>
               \let
                 | k_le_n : k <= n => NatSemiring.<=∘ k_le_m m_le_n
                 | hv_a' : M.validN k a' => M.cmra_validN_op_l k a' yf hv'_op
                 | hp_a' : P.upred_holds k a' => (hPQ k a' k_le_n hv_a').2 hq_a'
               \in inP (a', hv'_op, hp_a')
           })

-- | Monotonicity: `P |- Q` implies `|==> P |- |==> Q`. The frame-preserving witness
-- | `a'` produced for `|==> P` already satisfies `P`, hence `Q` by the entailment.
\lemma bupd_mono {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent P Q -> properUPred_ent (mkProperBUpd P) (mkProperBUpd Q) =>
  \lam hPQ n a hv hP k k_le_n yf hv_op =>
      \case hP k k_le_n yf hv_op \with {
        | inP (a', hv'_op, hp_a') =>
          \let
            | hv_a' : M.validN k a' => M.cmra_validN_op_l k a' yf hv'_op
            | hq_a' : Q.upred_holds k a' => hPQ k a' hv_a' hp_a'
          \in inP (a', hv'_op, hq_a')
      }

-- | Introduction: `P |- |==> P`. The trivial update keeps the resource `a` itself as
-- | the witness, so the frame `yf` stays valid; `upred_mono` re-derives `P` at the
-- | lower step index `k`.
\lemma bupd_intro {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent P (mkProperBUpd P) =>
  \lam n a hv hP k k_le_n yf hv_op =>
      inP (a, hv_op,
           P.upred_mono n k a a hP
               (inP (M.unit,
                     transport (\lam w => M.dist k a w)
                         (inv (ucmra_unit_right_id a))
                         (M.ofe_dist_refl k a)))
               k_le_n)

-- | Transitivity / idempotence: `|==> |==> P |- |==> P`. Run the outer update to get
-- | a witness `a'` satisfying `|==> P`, then run that inner update against the same
-- | frame `yf` to obtain a final witness `a''` satisfying `P`.
\lemma bupd_trans {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent (mkProperBUpd (mkProperBUpd P)) (mkProperBUpd P) =>
  \lam n a hv hPP k k_le_n yf hv_op =>
      \case hPP k k_le_n yf hv_op \with {
        | inP (a', hv'_op, hbupd_a') =>
          \case hbupd_a' k <=-refl yf hv'_op \with {
            | inP (a'', hv''_op, hp_a'') =>
              inP (a'', hv''_op, hp_a'')
          }
      }

-- | Framing: `(|==> P) * R |- |==> (P * R)`. The disjoint part `a2` owning `R` is
-- | absorbed into the frame `M.op a2 yf` while updating `a1`; the resulting witness
-- | `M.op a1' a2` then satisfies `P * R`. Associativity (`cmra_assoc`) reshuffles the
-- | validity proofs between `(a1*a2)*yf` and `a1*(a2*yf)`.
\lemma bupd_frame_r {M : UCMRA} (P R : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperBUpd P) R) (mkProperBUpd (mkProperSep P R)) =>
  \lam n a hv hsep => \case hsep \with {
    | inP (a1, a2, dist_a, hbupd, hR) =>
      \lam k k_le_n yf hv_op =>
          \let
            | dist_a_k : M.dist k a (M.op a1 a2) =>
              M.ofe_dist_le n k a (M.op a1 a2) dist_a k_le_n
            | dist_op_yf : M.dist k (M.op a yf) (M.op (M.op a1 a2) yf) =>
              M.cmra_op_ne_2 yf k a (M.op a1 a2) dist_a_k
            | hv_assoc_l : M.validN k (M.op (M.op a1 a2) yf) =>
              M.cmra_validN_ne k (M.op a yf) (M.op (M.op a1 a2) yf) dist_op_yf hv_op
            | hv_a1_a2yf : M.validN k (M.op a1 (M.op a2 yf)) =>
              transport (M.validN k) (inv (M.cmra_assoc a1 a2 yf)) hv_assoc_l
            | hP_step : TruncP (\Sigma (a1' : M.E)
                                       (M.validN k (M.op a1' (M.op a2 yf)))
                                       (P.upred_holds k a1')) =>
              hbupd k k_le_n (M.op a2 yf) hv_a1_a2yf
          \in \case hP_step \with {
            | inP (a1', hv_a1'_a2yf, hP_a1') =>
              \let
                | hv_a1'a2_yf : M.validN k (M.op (M.op a1' a2) yf) =>
                  transport (M.validN k) (M.cmra_assoc a1' a2 yf) hv_a1'_a2yf
                | inclN_a2 : inclN {M} {\new Op M.E { | op => M.op }} a2 k a2 =>
                  inP (M.unit,
                       transport (\lam w => M.dist k a2 w)
                           (inv (ucmra_unit_right_id a2))
                           (M.ofe_dist_refl k a2))
                | hR_k : R.upred_holds k a2 =>
                  R.upred_mono n k a2 a2 hR inclN_a2 k_le_n
                | hsep_new : (mkProperSep P R).upred_holds k (M.op a1' a2) =>
                  inP (a1', a2,
                       M.ofe_dist_refl k (M.op a1' a2),
                       hP_a1', hR_k)
              \in inP (M.op a1' a2, hv_a1'a2_yf, hsep_new)
          }
  }

-- | Extracts a pure fact from a single basic update: if `|==> ⌜φ⌝` holds at a valid
-- | resource, then `φ` holds in the metalogic. Instantiates the frame with the unit
-- | `M.unit`; the update's witness carries the pure proof of `φ` directly.
\lemma bupd_extract_pure {M : UCMRA} (phi : \Prop) (n : Nat) (a : M.E)
  : M.validN n a -> (mkProperBUpd (mkProperPure phi)).upred_holds n a -> phi =>
  \lam hv hbupd =>
      \let
        | hv_op : M.validN n (M.op a M.unit) =>
          transport (M.validN n) (inv (ucmra_unit_right_id a)) hv
      \in \case hbupd n <=-refl M.unit hv_op \with {
        | inP (_, _, hphi) => hphi
      }

-- | Soundness of iterated updates-under-laters: if `(|==> ▷)^k (|==> ⌜φ⌝)` holds at
-- | step `k` on a valid resource, then `φ` is true. This is the core lemma behind
-- | Iris's adequacy theorem — stripping `k` layers of `later` is sound because each
-- | layer drops the step index by one. Proven by induction on `k`: the base case is
-- | `bupd_extract_pure`; the step runs the outer update, lowers the index past the
-- | `later`, and recurses.
\lemma bupd_later_iter_soundness
  {M : UCMRA} (k : Nat) (phi : \Prop) (a : M.E)
  : M.validN k a ->
    (bupd_later_iter_fn k (mkProperBUpd (mkProperPure phi))).upred_holds k a -> phi
\elim k
  | 0     => \lam hv h => bupd_extract_pure phi 0 a hv h
  | suc k => \lam hv h =>
      \let
        | hv_op : M.validN (suc k) (M.op a M.unit) =>
          transport (M.validN (suc k)) (inv (ucmra_unit_right_id a)) hv
      \in \case h (suc k) <=-refl M.unit hv_op \with {
        | inP (a', hv'_op, hlater_a') =>
          \let
            | hv'_op_k : M.validN k (M.op a' M.unit) =>
              M.cmra_validN_le (suc k) k (M.op a' M.unit) hv'_op (n<=sucn k)
            | hv_a'  : M.validN k a' =>
              M.cmra_validN_op_l k a' M.unit hv'_op_k
            | h_k    : (bupd_later_iter_fn k (mkProperBUpd (mkProperPure phi))).upred_holds k a' =>
              hlater_a'
          \in bupd_later_iter_soundness k phi a' hv_a' h_k
      }


-- | Instance equipping `uPred(M)` with the basic update modality, realized by
-- | `mkProperBUpd`. Provides `bupd` without yet asserting its laws.
\instance UPredBUpd (M : UCMRA) : BUpd
  | BIBase => BIuPred M
  | bupd => mkProperBUpd

-- | Instance witnessing that `uPred(M)` is a `BiBUpd`: it bundles the BI structure
-- | (`BIuPredMixin`) with `bupd := mkProperBUpd` and discharges the four update
-- | axioms via the lemmas above. This is the concrete model making the basic update
-- | modality available throughout the Iris development.
\instance UPredBiBUpd (M : UCMRA) : BiBUpd
  | BIMixin => BIuPredMixin M
  | bupd => mkProperBUpd
  | bi_bupd_mixin_bupd_intro   => bupd_intro
  | bi_bupd_mixin_bupd_mono    => bupd_mono
  | bi_bupd_mixin_bupd_trans   => bupd_trans
  | bi_bupd_mixin_bupd_frame_r => bupd_frame_r

-- =================================================================================
-- Basic Laws for BUpd
-- =================================================================================


-- \func bupd_intro {B : BIMixin} {Bu : BiBUpd B} (P : B.E) : P |- Bu.bi_bupd_bupd.bupd P
--   => Bu.bi_bupd_mixin.bi_bupd_mixin_bupd_intro P
--
-- \func bupd_mono {B : BIMixin} {Bu : BiBUpd B} (P Q : B.E) (h : P |- Q)
--   : (Bu.bi_bupd_bupd.bupd P) |- (Bu.bi_bupd_bupd.bupd Q)
--   => Bu.bi_bupd_mixin.bi_bupd_mixin_bupd_mono P Q h
--
-- \func bupd_trans {B : BIMixin} {Bu : BiBUpd B} (P : B.E)
--   : (Bu.bi_bupd_bupd.bupd (Bu.bi_bupd_bupd.bupd P)) |- (Bu.bi_bupd_bupd.bupd P)
--   => Bu.bi_bupd_mixin.bi_bupd_mixin_bupd_trans P
--
-- \func bupd_frame_r {B : BIMixin} {Bu : BiBUpd B} (P R : B.E)
--   : ((Bu.bi_bupd_bupd.bupd P) * R) |- (Bu.bi_bupd_bupd.bupd (P * R))
--   => Bu.bi_bupd_mixin.bi_bupd_mixin_bupd_frame_r P R


-- =================================================================================
-- Derived Laws for BUpd
-- =================================================================================


-- | Left framing for `bupd`: `R * (|==> Q) |- |==> (R * Q)`. Derived from the
-- | primitive right-framing axiom by commuting the separating conjunction on both
-- | sides (`sep_comm_lemma`) and using monotonicity.
\func bupd_frame_l {Bu : BiBUpd} (R Q : Bu.E)
  : (R * bupd Q) |- bupd (R * Q)
  => Bu.<=-transitive
      (sep_comm_lemma R (bupd Q))
      (Bu.<=-transitive
          (bi_bupd_mixin_bupd_frame_r Q R)
          (bi_bupd_mixin_bupd_mono (Q * R) (R * Q) (sep_comm_lemma Q R)))

-- | Combining two updates: `(|==> P) * (|==> Q) |- |==> (P * Q)`. Frame `Q`'s update
-- | out to the right, push it under the first update with `bupd_frame_l`, then
-- | collapse the nested updates with transitivity.
\func bupd_sep {Bu : BiBUpd} (P Q : Bu.E)
  : (bupd P * bupd Q) |- bupd (P * Q)
  => Bu.<=-transitive
      (bi_bupd_mixin_bupd_frame_r P (bupd Q))
      (Bu.<=-transitive
          (bi_bupd_mixin_bupd_mono (P * bupd Q) (bupd (P * Q))
              (bupd_frame_l P Q))
          (bi_bupd_mixin_bupd_trans (P * Q)))


-- =================================================================================
-- Basic Laws for FUpd
-- =================================================================================


-- \func fupd_mask_subseteq {B : BIMixin} {Fu : BiFUpd B} (E1 E2 : Nat) (h : E2 <= E1)
--   : True {B} |- Fu.bi_fupd_fupd.fupd E1 E2 (Fu.bi_fupd_fupd.fupd E2 E1 emp)
--   => Fu.bi_fupd_mixin.bi_fupd_mixin_fupd_mask_subseteq E1 E2 h
--
-- \func fupd_mono {B : BIMixin} {Fu : BiFUpd B} (E1 E2 : Nat) (P Q : B.E) (h : P |- Q)
--   : (Fu.bi_fupd_fupd.fupd E1 E2 P) |- (Fu.bi_fupd_fupd.fupd E1 E2 Q)
--   => Fu.bi_fupd_mixin.bi_fupd_mixin_fupd_mono E1 E2 P Q h
--
-- \func fupd_trans {B : BIMixin} {Fu : BiFUpd B} (E1 E2 E3 : Nat) (P : B.E)
--   : (Fu.bi_fupd_fupd.fupd E1 E2 (Fu.bi_fupd_fupd.fupd E2 E3 P)) |- (Fu.bi_fupd_fupd.fupd E1 E3 P)
--   => Fu.bi_fupd_mixin.bi_fupd_mixin_fupd_trans E1 E2 E3 P
--
-- \func fupd_frame_r {B : BIMixin} {Fu : BiFUpd B} (E1 E2 : Nat) (P R : B.E)
--   : ((Fu.bi_fupd_fupd.fupd E1 E2 P) * R) |- (Fu.bi_fupd_fupd.fupd E1 E2 (P * R))
--   => Fu.bi_fupd_mixin.bi_fupd_mixin_fupd_frame_r E1 E2 P R


-- =================================================================================
-- Derived Laws for FUpd
-- =================================================================================


-- \func fupd_intro {B : BIMixin} {Fu : BiFUpd B} (E : Nat) (P : B.E)
--   : P |- (Fu.bi_fupd_fupd.fupd E E P)
--   => B.<=-transitive
--       (B.bi_mixin_pure_intro (\Sigma) P ())
--       (B.<=-transitive
--         (fupd_mask_subseteq E E <=-refl)
--         (B.<=-transitive
--           (fupd_mono E E (Fu.bi_fupd_fupd.fupd E E emp) (Fu.bi_fupd_fupd.fupd E E P)
--             (fupd_mono E E emp P (emp_sep_2_lemma P)))
--           (fupd_trans E E E P)))
--
-- \func fupd_frame_l {B : BIMixin} {Fu : BiFUpd B} (E1 E2 : Nat) (R Q : B.E)
--   : (R * (Fu.bi_fupd_fupd.fupd E1 E2 Q)) |- (Fu.bi_fupd_fupd.fupd E1 E2 (R * Q))
--   => B.<=-transitive
--       (sep_comm_lemma R (Fu.bi_fupd_fupd.fupd E1 E2 Q))
--       (B.<=-transitive
--         (fupd_frame_r E1 E2 Q R)
--         (fupd_mono E1 E2 (Q * R) (R * Q) (sep_comm_lemma Q R)))
--
-- \func fupd_sep {B : BIMixin} {Fu : BiFUpd B} (E : Nat) (P Q : B.E)
--   : ((Fu.bi_fupd_fupd.fupd E E P) * (Fu.bi_fupd_fupd.fupd E E Q)) |- (Fu.bi_fupd_fupd.fupd E E (P * Q))
--   => B.<=-transitive
--       (fupd_frame_r E E P (Fu.bi_fupd_fupd.fupd E E Q))
--       (B.<=-transitive
--         (fupd_mono E E (P * (Fu.bi_fupd_fupd.fupd E E Q)) (Fu.bi_fupd_fupd.fupd E E (P * Q))
--           (fupd_frame_l E E P Q))
--         (fupd_trans E E E (P * Q)))
