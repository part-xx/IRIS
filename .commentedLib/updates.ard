-- | Module `updates`: update modalities for the Iris BI logic over `uPred(M)`.
-- |
-- | This module formalizes Iris's *basic update modality* `|==> P` (here `bupd`),
-- | which expresses a frame-preserving update of the resources: from the current
-- | ownership we may move to a new state satisfying `P` while keeping any frame
-- | (the `yf` in the semantics) valid. Concretely, on `uPred(M)` the modality is
-- | `mkProperBUpd` from `uPred.ard`, which quantifies over an arbitrary frame and
-- | produces a new resource `a'` validating it.
-- |
-- | Contents:
-- |   * `BUpd` / `BiBUpd` — the algebraic interface bundling `bupd` with its laws
-- |     (intro, mono, trans, frame), mirroring Iris's `BiBUpd` typeclass.
-- |   * `BIuPredMixin` — the full BI (bunched-implication) structure on `uPred(M)`:
-- |     proofs that the propositional/quantifier/separation connectives satisfy the
-- |     `BIMixin` axioms.
-- |   * The semantic lemmas (`bupd_ne`, `bupd_mono`, `bupd_intro`, `bupd_trans`,
-- |     `bupd_frame_r`) discharging the `bupd` axioms for `uPred(M)`, and the
-- |     instances `UPredBUpd` / `UPredBiBUpd` packaging them.
-- |     `bupd_extract_pure` and `bupd_later_iter_soundness` are the soundness
-- |     ingredients used by Iris adequacy: a pure fact under any number of nested
-- |     `bupd`/`later` modalities really holds.
-- |   * Derived structural laws `bupd_frame_l` and `bupd_sep`.
-- |
-- | Commented-out blocks sketch the analogous *fancy update* `|={E1,E2}=>` (`FUpd`)
-- | interface, kept for future development.


-- =================================================================================
-- Update Modalities for BI
-- =================================================================================


-- | Interface adding the basic update modality `bupd : P -> |==> P` to a BI base.
-- | An `E -> E` operation on propositions; the laws live in `BiBUpd`.
\class BUpd \extends BIBase
  | bupd : E -> E

-- \class FUpd (B : BIBase)
--   | fupd : Nat -> Nat -> B.E -> B.E


-- =================================================================================
-- BUpd Mixin: Axioms for Basic Updates
-- =================================================================================

-- | The axioms of the basic update modality, bundled with the BI structure.
-- | These are exactly Iris's `bupd` laws:
-- |   * `bupd_intro`  : `P |- |==> P` (any state is reachable by the trivial update);
-- |   * `bupd_mono`   : `bupd` is monotone w.r.t. entailment;
-- |   * `bupd_trans`  : `|==> |==> P |- |==> P` (updates compose);
-- |   * `bupd_frame_r`: `(|==> P) * R |- |==> (P * R)` (frame untouched resources).
\class BiBUpd \extends BUpd, BIMixin {
  | bi_bupd_mixin_bupd_intro (P : E) : P |- bupd P
  | bi_bupd_mixin_bupd_mono (P Q : E) : (P |- Q) -> (bupd P) |- (bupd Q)
  | bi_bupd_mixin_bupd_trans (P : E) : (bupd (bupd P)) |- (bupd P)
  | bi_bupd_mixin_bupd_frame_r (P R : E) : ((bupd P) * R) |- (bupd (P * R))
}


-- | The BI structure on `uPred(M)`: proofs that the connectives defined in
-- | `uPred.ard` satisfy every `BIMixin` axiom. This turns step-indexed, resource
-- | monotone predicates over a unital CMRA `M` into a model of bunched-implication
-- | logic, with `*`/`-*` the separating conjunction/magic wand, `emp` the unit, and
-- | the usual intuitionistic connectives. The field proofs reason pointwise at step
-- | index `n` and resource `a`, using CMRA validity/distance facts (`cmra_validN_*`,
-- | `cmra_comm`, `cmra_assoc`, `ofe_dist_*`) and `upred_mono` to transport along
-- | resource inclusion and step-index decrease.
\instance BIuPredMixin (M : UCMRA) : BIMixin
  | BIBase => BIuPred M
  | bi_mixin_pure_intro phi P =>
    \lam hphi n a _ _ => hphi
  | bi_mixin_pure_elim phi P =>
    \lam h n a hv hp => h hp n a hv ()
  | bi_mixin_and_intro P Q R =>
    \lam hPQ hPR n a hv hp =>
        (hPQ n a hv hp, hPR n a hv hp)
  | bi_mixin_and_elim_l P Q =>
    \lam n a _ hpq => hpq.1
  | bi_mixin_and_elim_r P Q =>
    \lam n a _ hpq => hpq.2
  | bi_mixin_or_intro_l P Q =>
    \lam n a _ hp => byLeft hp
  | bi_mixin_or_intro_r P Q =>
    \lam n a _ hq => byRight hq
  | bi_mixin_or_elim P Q R =>
    \lam hPR hQR n a hv hpq => \case hpq \with {
      | byLeft hp  => hPR n a hv hp
      | byRight hq => hQR n a hv hq
    }
  | bi_mixin_impl_intro_r P Q R h =>
    \lam n a hv hp m m_le_n b incl_a_b hv_b hq_b =>
        h m b hv_b
            (P.upred_mono n m a b hp incl_a_b m_le_n, hq_b)
  | bi_mixin_impl_elim_l P Q R =>
    \lam hPI n a hv hpq =>
        hPI n a hv hpq.1 n <=-refl a
            (inP (M.unit,
                  transport (\lam w => M.dist n a w)
                      (inv (ucmra_unit_right_id a))
                      (M.ofe_dist_refl n a)))
            hv hpq.2
  | bi_mixin_forall_intro {A} P Phi =>
    \lam h n a hv hp t => h t n a hv hp
  | bi_mixin_forall_elim {A} Phi t =>
    \lam n a _ h => h t
  | bi_mixin_exist_intro {A} Phi t =>
    \lam n a _ h => inP (t, h)
  | bi_mixin_exist_elim {A} Phi Q =>
    \lam h n a hv hex => \case hex \with {
      | inP (t, ht) => h t n a hv ht
    }
  | bi_mixin_sep_mono P P' Q Q' =>
    \lam hPP' hQQ' n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hp, hq) =>
        \let
          | hv_op : M.validN n (M.op a1 a2) => M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
          | hv_a1 : M.validN n a1 => M.cmra_validN_op_l n a1 a2 hv_op
          | hv_a2 : M.validN n a2 => cmra_validN_op_r {M} n a1 a2 hv_op
        \in inP (a1, a2, dist_a, hPP' n a1 hv_a1 hp, hQQ' n a2 hv_a2 hq)
    }
  | bi_mixin_emp_sep_1 P =>
    \lam n a hv hp =>
        inP (M.unit, a,
             transport (\lam w => M.dist n a w) (inv (M.ucmra_unit_left_id a))
                 (M.ofe_dist_refl n a),
             inP (M.unit,
                  transport (\lam w => M.dist n M.unit w)
                      (inv (M.ucmra_unit_left_id M.unit))
                      (M.ofe_dist_refl n M.unit)),
             hp)
  | bi_mixin_emp_sep_2 P =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, _, hp) =>
        \let
          | dist_swap : M.dist n a (M.op a2 a1) =>
            M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1)
                dist_a
                (equiv_dist_n {M} (M.op a1 a2) (M.op a2 a1) (M.cmra_comm a1 a2) n)
          | inclN_a2_a : inclN {M} {\new Op M.E { | op => M.op }} a2 n a =>
            inP (a1, dist_swap)
        \in P.upred_mono n n a2 a hp inclN_a2_a <=-refl
    }
  | bi_mixin_sep_comm P Q =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hp, hq) =>
        inP (a2, a1,
             M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1)
                 dist_a
                 (equiv_dist_n {M} (M.op a1 a2) (M.op a2 a1) (M.cmra_comm a1 a2) n),
             hq, hp)
    }
  | bi_mixin_sep_assoc P Q R =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hpq, hr) => \case hpq \with {
        | inP (b1, b2, dist_a1, hp, hq) =>
          \let
            | dist_op : M.dist n (M.op a1 a2) (M.op (M.op b1 b2) a2) =>
              M.cmra_op_ne_2 a2 n a1 (M.op b1 b2) dist_a1
            | dist_a_op : M.dist n a (M.op (M.op b1 b2) a2) =>
              M.ofe_dist_trans n a (M.op a1 a2) (M.op (M.op b1 b2) a2) dist_a dist_op
            | dist_a_assoc : M.dist n a (M.op b1 (M.op b2 a2)) =>
              transport (\lam w => M.dist n a w) (inv (M.cmra_assoc b1 b2 a2)) dist_a_op
          \in inP (b1, M.op b2 a2, dist_a_assoc, hp,
                   inP (b2, a2, M.ofe_dist_refl n (M.op b2 a2), hq, hr))
      }
    }
  | bi_mixin_wand_intro P Q R h =>
    \lam n a1 hv hp m m_le_n a2 hv_op hq =>
        h m (M.op a1 a2) hv_op
            (inP (a1, a2, M.ofe_dist_refl m (M.op a1 a2),
                  P.upred_mono n m a1 a1 hp
                      (inP (M.unit, transport (\lam w => M.dist m a1 w)
                          (inv (ucmra_unit_right_id a1)) (M.ofe_dist_refl m a1)))
                      m_le_n,
                  hq))
  | bi_mixin_wand_elim P Q =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hp, hwand) =>
        \let
          | hv_op : M.validN n (M.op a1 a2) =>
            M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
          | dist_swap : M.dist n (M.op a1 a2) (M.op a2 a1) =>
            equiv_dist_n {M} (M.op a1 a2) (M.op a2 a1) (M.cmra_comm a1 a2) n
          | hv_swap : M.validN n (M.op a2 a1) =>
            M.cmra_validN_ne n (M.op a1 a2) (M.op a2 a1) dist_swap hv_op
          | hq_swap : Q.upred_holds n (M.op a2 a1) =>
            hwand n <=-refl a1 hv_swap hp
          | dist_a_swap : M.dist n a (M.op a2 a1) =>
            M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1) dist_a dist_swap
          | inclN_swap_a : inclN {M} {\new Op M.E { | op => M.op }} (M.op a2 a1) n a =>
            inP (M.unit,
                 transport (\lam w => M.dist n a w)
                     (inv (ucmra_unit_right_id (M.op a2 a1)))
                     dist_a_swap)
        \in Q.upred_mono n n (M.op a2 a1) a hq_swap inclN_swap_a <=-refl
    }

