\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Data.Maybe
\import Data.Or
\import Arith.Nat
\import ofe
\import cmra
\import interface
\import Order.PartialOrder
\import Order.LinearOrder


-- | Implementation of the @uPred@ model of Iris's separation logic over a unital CMRA @M@.
-- |
-- | In Iris a proposition is interpreted as a step-indexed predicate on resources: a family
-- | of sets of resources indexed by an approximation level (the "step index") @n : Nat@.
-- | This module defines that model and equips it with the full BI (bunched implication)
-- | structure used by Iris: the pure/emp/and/or/impl/forall/exist/sep/wand connectives,
-- | together with the modalities @▷@ (later) and @□@ (persistently), as well as the basic
-- | update modality @|==>@ (frame-preserving updates).
-- |
-- | The raw carrier is @uPred M = Nat -> M.E -> \Prop@; the well-formed propositions are
-- | the monotone ones, captured by 'ProperUPred' (closed under decreasing step index and
-- | step-indexed resource inclusion). 'BIuPred' bundles the connectives into a 'BIBase'
-- | instance, while 'UPredOFE' / 'UPredCOFE' give the (complete) ordered family of equivalences
-- | structure required to solve recursive domain equations and define guarded fixed points.

-- | The raw carrier of step-indexed uniform predicates over a unital CMRA @M@:
-- | a predicate on a step index @n@ and a resource @x : M.E@. Well-formedness (monotonicity)
-- | is imposed separately by 'ProperUPred'.
\func uPred (M : UCMRA) : \Type => Nat -> M.E -> \Prop


-- | A well-formed Iris proposition over @M@: a step-indexed predicate that is monotone.
-- | 'upred_mono' is the defining closure condition — if the predicate holds at level @n1@
-- | for @x1@, then it also holds at any smaller level @n2 <= n1@ for any resource @x2@ that
-- | step-indexedly includes @x1@ (@x1 ≼{n2} x2@). This makes propositions both downward
-- | closed in the step index and closed under extension of the resource (the Iris notion of
-- | a uniform predicate).
\record ProperUPred (M : UCMRA)
  | upred_holds : Nat -> M.E -> \Prop
  | upred_mono : \Pi (n1 n2 : Nat) (x1 x2 : M.E) ->
    upred_holds n1 x1 ->
    inclN {M} {\new Op M.E { | op => M.op }} x1 n2 x2 ->
    n2 <= n1 ->
    upred_holds n2 x2

-- | Entailment @P ⊢ Q@ in the uPred model: at every step index @n@ and every @n@-valid
-- | resource @a@, whenever @P@ holds, @Q@ holds. This is the order underlying 'BIuPred'.
\func properUPred_ent {M : UCMRA} (P Q : ProperUPred M) : \Prop =>
  \Pi (n : Nat) (a : M.E) -> M.validN n a -> P.upred_holds n a -> Q.upred_holds n a

-- | Reflexivity of entailment: @P ⊢ P@.
\func properUPred_ent_refl {M : UCMRA} (P : ProperUPred M) : properUPred_ent P P =>
  \lam n a _ h => h

-- | Transitivity of entailment: from @P ⊢ Q@ and @Q ⊢ R@ derive @P ⊢ R@.
\func properUPred_ent_trans {M : UCMRA} (P Q R : ProperUPred M)
                            (h1 : properUPred_ent P Q) (h2 : properUPred_ent Q R) : properUPred_ent P R =>
  \lam n a hv hp => h2 n a hv (h1 n a hv hp)

-- | The pure embedding @⌜φ⌝@: lifts a meta-level proposition @φ@ into uPred, ignoring the
-- | resource and step index. Monotonicity is trivial since the body does not depend on them.
\func mkProperPure {M : UCMRA} (phi : \Prop) : ProperUPred M \cowith
  | upred_holds => \lam n a => phi
  | upred_mono => \lam n1 n2 x1 x2 h _ _ => h

-- | The separation-logic unit @emp@: holds at @(n, a)@ iff the CMRA unit is @n@-included in @a@,
-- | i.e. @a@ contains no proper resource at level @n@. The 'upred_mono' proof combines two
-- | inclusion witnesses and rewrites with the unit/associativity laws to re-express the chained
-- | distances against the unit element.
\func mkProperEmp {M : UCMRA} : ProperUPred M \cowith
  | upred_holds => \lam n a => inclN {M} {\new Op M.E { | op => M.op }} M.unit n a
  | upred_mono => \lam n1 n2 x1 x2 h_incl incl n2_le_n1 =>
    \case h_incl, incl \with {
      | inP (z1, dist_x1_uz1), inP (z2, dist_x2_x1z2) =>
        inP (M.op z1 z2,
             transport (\lam w => M.dist n2 x2 w) (inv (M.ucmra_unit_left_id (M.op z1 z2)))
               (M.ofe_dist_trans n2 x2 (M.op x1 z2) (M.op z1 z2)
                 dist_x2_x1z2
                 (M.cmra_op_ne_2 z2 n2 x1 z1
                   (transport (\lam w => M.dist n2 x1 w) (M.ucmra_unit_left_id z1)
                     (M.ofe_dist_le n1 n2 x1 (M.op M.unit z1) dist_x1_uz1 n2_le_n1)))))

    }


-- | Conjunction @P ∧ Q@: holds at @(n, a)@ iff both @P@ and @Q@ hold there. Monotonicity is
-- | componentwise.
\func mkProperAnd {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Sigma (P.upred_holds n a) (Q.upred_holds n a)
  | upred_mono => \lam n1 n2 x1 x2 (h_P, h_Q) incl n2_le_n1 =>
    (P.upred_mono n1 n2 x1 x2 h_P incl n2_le_n1, Q.upred_mono n1 n2 x1 x2 h_Q incl n2_le_n1)

-- | Disjunction @P ∨ Q@: holds at @(n, a)@ iff @P@ or @Q@ holds there. Monotonicity dispatches
-- | on which disjunct holds and propagates it.
\func mkProperOr {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => (P.upred_holds n a) || (Q.upred_holds n a)
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case h \with {
    | byLeft h_P => byLeft (P.upred_mono n1 n2 x1 x2 h_P incl n2_le_n1)
    | byRight h_Q => byRight (Q.upred_mono n1 n2 x1 x2 h_Q incl n2_le_n1)
  }

-- | Implication @P → Q@: holds at @(n, a)@ iff for every smaller level @m@, every @m@-valid
-- | extension @b@ of @a@ at which @P@ holds, @Q@ also holds at @(m, b)@. Quantifying over future
-- | levels and larger resources is what makes implication monotone; 'upred_mono' just composes
-- | the inclusion witnesses with 'inclN_trans'/'inclN_le'.
\func mkProperImpl {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Pi (m : Nat) -> m <= n -> \Pi (b : M.E) ->
      inclN {M} {\new Op M.E { | op => M.op }} a m b ->
      M.validN m b -> P.upred_holds m b -> Q.upred_holds m b
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 m m_le_n2 b incl_x2_b hv hp =>
      h m (NatSemiring.<=∘ m_le_n2 n2_le_n1) b
          (inclN_trans m x1 x2 b
              (inclN_le {M} {\new Op M.E { | op => M.op }} x1 x2 n2 m incl m_le_n2)
              incl_x2_b)
          hv hp

-- | Universal quantification @∀ t : T, Φ t@: holds at @(n, a)@ iff every instance @Φ t@ holds
-- | there. Monotonicity is pointwise in @t@.
\func mkProperForall {M : UCMRA} (T : \Type) (Phi : T -> ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Pi (t : T) -> (Phi t).upred_holds n a
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 t =>
      (Phi t).upred_mono n1 n2 x1 x2 (h t) incl n2_le_n1

-- | Existential quantification @∃ t : T, Φ t@: holds at @(n, a)@ iff @Φ t@ holds there for some
-- | @t@ (propositionally truncated). Monotonicity transports the witness through 'upred_mono'.
\func mkProperExist {M : UCMRA} (T : \Type) (Phi : T -> ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => TruncP (\Sigma (t : T) ((Phi t).upred_holds n a))
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case h \with {
    | inP (t, h_t) => inP (t, (Phi t).upred_mono n1 n2 x1 x2 h_t incl n2_le_n1)
  }

-- | Separating conjunction @P ∗ Q@: holds at @(n, a)@ iff @a@ splits @n@-approximately as
-- | @a ≡{n} a1 · a2@ with @P@ holding for @a1@ and @Q@ for @a2@. The 'upred_mono' proof takes
-- | the extension @x2 ≡{n2} x1 · z@, re-associates the split as @a1 · (a2 · z)@, and keeps the
-- | extra resource @z@ inside the second component.
\func mkProperSep {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => TruncP (\Sigma (a1 a2 : M.E) (M.dist n a (M.op a1 a2)) (P.upred_holds n a1) (Q.upred_holds n a2))
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case h, incl \with {
    | inP (a1, a2, dist_x1, hp, hq), inP (z, dist_x2) =>
      \let inclN_refl : \Pi (a : M.E) -> inclN {M} {\new Op M.E { | op => M.op }} a n2 a =>
        \lam a => inP (M.unit, transport (\lam w => M.dist n2 a w) (inv (ucmra_unit_right_id a)) (M.ofe_dist_refl n2 a))
      \in inP (a1, M.op a2 z,
               M.ofe_dist_trans n2 x2 (M.op x1 z) (M.op a1 (M.op a2 z))
                 dist_x2
                 (transport (\lam w => M.dist n2 (M.op x1 z) w)
                   (inv (M.cmra_assoc a1 a2 z))
                   (M.cmra_op_ne_2 z n2 x1 (M.op a1 a2)
                     (M.ofe_dist_le n1 n2 x1 (M.op a1 a2) dist_x1 n2_le_n1))),
               P.upred_mono n1 n2 a1 a1 hp (inclN_refl a1) n2_le_n1,
               Q.upred_mono n1 n2 a2 (M.op a2 z) hq (cmra_includedN_l n2 a2 z) n2_le_n1)
  }


-- | Magic wand @P -∗ Q@: holds at @(n, a1)@ iff for every smaller level @m@ and resource @a2@
-- | such that @a1 · a2@ is @m@-valid and @P@ holds at @a2@, @Q@ holds at @a1 · a2@. The
-- | 'upred_mono' proof transfers the hypothesis along @x1 ≼ x2@ using 'inclN_op_r' and validity
-- | under inclusion ('cmra_validN_includedN').
\func mkProperWand {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a1 => \Pi (m : Nat) -> m <= n -> \Pi (a2 : M.E) ->
      M.validN m (M.op a1 a2) -> P.upred_holds m a2 -> Q.upred_holds m (M.op a1 a2)
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 m m_le_n2 a2 hv hp =>
      \let
        | inclN_x1x2 : inclN {M} {\new Op M.E { | op => M.op }} x1 m x2 =>
          inclN_le x1 x2 n2 m incl m_le_n2
        | hv_x1a2 : M.validN m (M.op x1 a2) =>
          cmra_validN_includedN {M} m (M.op x1 a2) (M.op x2 a2) hv (inclN_op_r m x1 x2 a2 inclN_x1x2)
      \in Q.upred_mono m m (M.op x1 a2) (M.op x2 a2)
          (h m (NatSemiring.<=∘ m_le_n2 n2_le_n1) a2 hv_x1a2 hp)
          (inclN_op_r m x1 x2 a2 inclN_x1x2)
          <=-refl


-- | The later modality @▷ P@: holds trivially at step index @0@ and otherwise holds at @suc n'@
-- | iff @P@ holds at @n'@. This shifts the predicate down one step index, encoding Iris's guarded
-- | recursion. Monotonicity case-splits on the indices, using @0@ as the trivial base case.
\func mkProperLater {M : UCMRA} (P : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \case n \with {
    | 0 => \Sigma
    | suc n' => P.upred_holds n' a
  }
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case \elim n1, \elim n2, h, incl, n2_le_n1 \with {
    | _, 0, _, _, _ => ()
    | 0, suc n2', _, _, le => absurd (le NatOrder.zero<suc)
    | suc n1', suc n2', h_p, incl', le =>
      P.upred_mono n1' n2' x1 x2 h_p
          (inclN_le x1 x2 (suc n2') n2' incl' (n<=sucn n2'))
          (suc<=suc.conv le)
  }

-- | The persistently modality @□ P@: holds at @(n, a)@ iff @P@ holds at every smaller level @m@
-- | for every @b@ that @m@-includes the unit. Evaluating @P@ on the core/unit part rather than on
-- | @a@ itself makes @□ P@ duplicable and resource-independent. Monotonicity is immediate since the
-- | body already quantifies over future levels and unit-extensions.
\func mkProperPersistently {M : UCMRA} (P : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Pi (m : Nat) -> m <= n -> \Pi (b : M.E) ->
      inclN {M} {\new Op M.E { | op => M.op }} M.unit m b -> P.upred_holds m b
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 m m_le_n2 b unit_incl_b =>
      h m (NatSemiring.<=∘ m_le_n2 n2_le_n1) b unit_incl_b


-- | The BI structure of the uPred model: assembles all the connectives defined above into a
-- | 'BIBase' instance over the proposition type @ProperUPred M@, with entailment as the order.
-- | This is the concrete BI algebra on which Iris's logic and proof rules are interpreted.
\instance BIuPred (M : UCMRA) : BIBase \cowith
  | E => ProperUPred M
  | <= => properUPred_ent
  | <=-refl => \lam n a _ h => h
  | <=-transitive => \lam h1 h2 n a hv hp => h2 n a hv (h1 n a hv hp)
  | bi_emp => mkProperEmp
  | bi_pure => mkProperPure
  | bi_and => mkProperAnd
  | bi_or => mkProperOr
  | bi_impl => mkProperImpl
  | bi_forall => mkProperForall
  | bi_exist => mkProperExist
  | bi_sep => mkProperSep
  | bi_wand => mkProperWand
  | bi_persistently => mkProperPersistently
  | bi_later => mkProperLater


-- =================================================================================
-- OFE and COFE for ProperUPred
-- =================================================================================


-- | Monotonicity of @∀@ under pointwise entailment: if @Φ t ⊢ Ψ t@ for all @t@, then
-- | @(∀ t, Φ t) ⊢ (∀ t, Ψ t)@.
\lemma proper_forall_mono {M : UCMRA} {T : \Type} (Phi Psi : T -> ProperUPred M)
                          (h : \Pi (t : T) -> properUPred_ent (Phi t) (Psi t))
  : properUPred_ent (mkProperForall T Phi) (mkProperForall T Psi)
  => \lam n a hv hPhi t => h t n a hv (hPhi t)

-- | Right monotonicity of @∧@: from @Q ⊢ Q'@ derive @P ∧ Q ⊢ P ∧ Q'@.
\lemma proper_and_mono_r {M : UCMRA} (P Q Q' : ProperUPred M)
                         (h : properUPred_ent Q Q') : properUPred_ent (mkProperAnd P Q) (mkProperAnd P Q')
  => \lam n a hv hPQ => (hPQ.1, h n a hv hPQ.2)

-- | Monotonicity of @▷@: from @P ⊢ Q@ derive @▷ P ⊢ ▷ Q@. The proof case-splits on the step index;
-- | at @suc n'@ it applies @h@ at @n'@, using 'cmra_validN_le' to lower validity by one step.
\lemma proper_later_mono {M : UCMRA} (P Q : ProperUPred M)
                         (h : properUPred_ent P Q) : properUPred_ent (mkProperLater P) (mkProperLater Q)
  => \lam n a hv hP => \case \elim n, hv, hP \with {
    | 0, _, _ => ()
    | suc n', hv', hP' => h n' a (M.cmra_validN_le (suc n') n' a hv' (n<=sucn n')) hP'
  }

-- | Right monotonicity of @→@: from @Q ⊢ Q'@ derive @(P → Q) ⊢ (P → Q')@.
\lemma proper_impl_mono_r {M : UCMRA} (P Q Q' : ProperUPred M)
                          (h : properUPred_ent Q Q') : properUPred_ent (mkProperImpl P Q) (mkProperImpl P Q')
  => \lam n a hv himpl m m_le_n b incl_a_b hv_b hp =>
      h m b hv_b (himpl m m_le_n b incl_a_b hv_b hp)

-- =================================================================================
-- OFE and COFE for ProperUPred
-- =================================================================================


-- | The step-indexed distance on propositions: @P ≡{n} Q@ holds iff @P@ and @Q@ agree (in both
-- | directions) at every level @m <= n@ and every @m@-valid resource @a@. This is the OFE
-- | distance making the connectives non-expansive.
\func upredDist {M : UCMRA} (n : Nat) (P Q : ProperUPred M) : \Prop =>
  \Pi (m : Nat) (a : M.E) -> m <= n -> M.validN m a ->
  \Sigma (P.upred_holds m a -> Q.upred_holds m a)
         (Q.upred_holds m a -> P.upred_holds m a)

-- | OFE equivalence of propositions: @P@ and @Q@ agree at every step index on every valid
-- | resource. This is the equality (extensional equivalence) of the uPred OFE.
\func upredEquiv {M : UCMRA} (P Q : ProperUPred M) : \Prop =>
  \Pi (n : Nat) (a : M.E) -> M.validN n a ->
  \Sigma (P.upred_holds n a -> Q.upred_holds n a)
         (Q.upred_holds n a -> P.upred_holds n a)

-- | The OFE of uPred propositions over @M@: carrier @ProperUPred M@ with distance 'upredDist'
-- | and equivalence 'upredEquiv'. All the OFE axioms (reflexivity, symmetry, transitivity,
-- | monotonicity in the step index, and equivalence-is-distance-at-all-levels) reduce to the
-- | corresponding bi-implications between membership at @(m, a)@.
\func UPredOFE (M : UCMRA) : OFE \cowith
  | E => ProperUPred M
  | dist => upredDist
  | equiv => upredEquiv
  | equiv_refl P n a _ => (\lam h => h, \lam h => h)
  | equiv_sym P Q h n a hv =>
    \let r => h n a hv \in (r.2, r.1)
  | equiv_trans P Q R h1 h2 n a hv =>
    \let pq => h1 n a hv | qr => h2 n a hv
    \in (\lam hp => qr.1 (pq.1 hp), \lam hr => pq.2 (qr.2 hr))
  | ofe_equiv_dist => \lam P Q => (
    \lam heq n m a hle hv => heq m a hv,
    \lam hd n a hv => hd n n a <=-refl hv
  )
  | ofe_dist_refl => \lam n P m a _ _ => (\lam h => h, \lam h => h)
  | ofe_dist_sym => \lam n P Q hPQ m a hle hv =>
      \let r => hPQ m a hle hv \in (r.2, r.1)
  | ofe_dist_trans => \lam n P Q R hPQ hQR m a hle hv =>
      \let pq => hPQ m a hle hv
           | qr => hQR m a hle hv
      \in (\lam hp => qr.1 (pq.1 hp), \lam hr => pq.2 (qr.2 hr))
  | ofe_dist_le => \lam n k P Q h hle m a hm hv =>
      h m a (NatSemiring.<=∘ hm hle) hv


-- | The limit of a chain of propositions, used to make the uPred OFE complete (a COFE).
-- | The limit holds at @(n, a)@ iff every chain element @c n'@ holds at @(n', a)@ for all
-- | @n' <= n@ (with @a@ being @n'@-valid). This "diagonal" definition guarantees the limit is
-- | itself monotone and is the proposition the chain converges to; the 'upred_mono' proof relays
-- | monotonicity of each @c n'@ along the inclusion, restricting validity via 'cmra_validN_includedN'.
\func upred_compl {M : UCMRA} (c : Nat -> ProperUPred M) (hc : Chain {UPredOFE M} c)
  : ProperUPred M \cowith
  | upred_holds => \lam n a =>
      \Pi (n' : Nat) -> n' <= n -> M.validN n' a -> (c n').upred_holds n' a
  | upred_mono => \lam n1 n2 x1 x2 h hincl le n' n'_le_n2 hv' =>
          (c n').upred_mono n' n' x1 x2
          (h n' (NatSemiring.<=∘ n'_le_n2 le)
              (cmra_validN_includedN {M} n' x1 x2 hv'
                  (inclN_le {M} {\new Op M.E { | op => M.op }} x1 x2 n2 n' hincl n'_le_n2)))
          (inclN_le {M} {\new Op M.E { | op => M.op }} x1 x2 n2 n' hincl n'_le_n2)
          <=-refl


-- | The COFE of uPred propositions: 'UPredOFE' together with the limit operator 'upred_compl'.
-- | The 'cofe_conv_compl' field proves the limit is @n@-close to each chain element @c n@, using
-- | the Cauchy property of the chain ('chain_cauchy') in both directions; completeness is what
-- | enables solving recursive domain equations and defining guarded fixed points over uPred.
\func UPredCOFE (M : UCMRA) : COFE \cowith
  | OFE => UPredOFE M
  | compl => upred_compl
  | cofe_conv_compl => \lam c hc n m a hle hv =>
      ( \lam h => (hc.chain_cauchy m n hle m a <=-refl hv).2 (h m <=-refl hv)
      , \lam h => \lam n' n'_le_m hv' =>
          (hc.chain_cauchy n' n (NatSemiring.<=∘ n'_le_m hle) n' a <=-refl hv').1
              ((c n).upred_mono m n' a a h
                  (inP (M.unit, transport (\lam w => M.dist n' a w)
                      (inv (ucmra_unit_right_id a)) (M.ofe_dist_refl n' a)))
                  n'_le_m)
      )



-- =================================================================================
-- Non-expansiveness helpers for upredDist
-- =================================================================================


-- | Downward monotonicity of the distance in the step index: @P ≡{n} Q@ and @k <= n@ imply
-- | @P ≡{k} Q@.
\lemma upredDist_le {M : UCMRA} (n k : Nat) (P Q : ProperUPred M)
                    (h : upredDist n P Q) (hle : k <= n) : upredDist k P Q =>
  \lam m a hm hv => h m a (NatSemiring.<=∘ hm hle) hv

-- | Non-expansiveness of @▷@ (contractiveness step): if @P ≡{k} Q@ for all @k < n@, then
-- | @▷ P ≡{n} ▷ Q@. (Proof currently a hole.)
\lemma upredDist_later {M : UCMRA} (n : Nat) (P Q : ProperUPred M)
                       (h : \Pi (k : Nat) -> k NatOrder.< n -> upredDist k P Q)
  : upredDist n (mkProperLater P) (mkProperLater Q) => {?}

-- | Non-expansiveness of @∀@: if @F t ≡{n} G t@ for every @t@, then
-- | @(∀ t, F t) ≡{n} (∀ t, G t)@.
\lemma upredDist_forall {M : UCMRA} (T : \Type) (n : Nat)
                        (F G : T -> ProperUPred M)
                        (h : \Pi (t : T) -> upredDist n (F t) (G t))
  : upredDist n (mkProperForall T F) (mkProperForall T G) =>
  \lam m a hm hv =>
      ( \lam hF t => (h t m a hm hv).1 (hF t)
      , \lam hG t => (h t m a hm hv).2 (hG t)
      )

-- | Right non-expansiveness of @→@: if @Q ≡{n} Q'@ then @(P → Q) ≡{n} (P → Q')@.
-- | (Proof currently a hole.)
\lemma upredDist_impl_r {M : UCMRA} (n : Nat) (P Q Q' : ProperUPred M)
                        (h : upredDist n Q Q')
  : upredDist n (mkProperImpl P Q) (mkProperImpl P Q') => {?}

-- | Right non-expansiveness of @∗@: if @P ≡{n} Q@ then @(R ∗ P) ≡{n} (R ∗ Q)@.
-- | (Proof currently a hole.)
\lemma upredDist_sep_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                       (h : upredDist n P Q)
  : upredDist n (mkProperSep R P) (mkProperSep R Q) => {?}

-- | Right non-expansiveness of @∧@: if @P ≡{n} Q@ then @(R ∧ P) ≡{n} (R ∧ Q)@.
-- | (Proof currently a hole.)
\lemma upredDist_and_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                       (h : upredDist n P Q)
  : upredDist n (mkProperAnd R P) (mkProperAnd R Q) => {?}

-- | Right non-expansiveness of @-∗@: if @P ≡{n} Q@ then @(R -∗ P) ≡{n} (R -∗ Q)@.
-- | (Proof currently a hole.)
\lemma upredDist_wand_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                        (h : upredDist n P Q)
  : upredDist n (mkProperWand R P) (mkProperWand R Q) => {?}


-- =================================================================================
-- uPred updates
-- =================================================================================

-- | The basic update modality @|==> P@ (frame-preserving update): holds at @(n, a)@ iff for every
-- | @k <= n@ and every frame @yf@ such that @a · yf@ is @k@-valid, there exists a new resource @a'@
-- | with @a' · yf@ @k@-valid and @P@ holding at @(k, a')@. Intuitively, @a@ can be updated to some
-- | @a'@ satisfying @P@ without invalidating any frame. The 'upred_mono' proof, given an extension
-- | @x2 ≡ x1 · x3@, folds the extra @x3@ into the frame (@yf ↦ x3 · yf@), runs the update on @x1@,
-- | and recombines the result @a'@ with @x3@, using associativity to realign the operands.
\func mkProperBUpd {M : UCMRA} (P : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a =>
      \Pi (k : Nat) -> k <= n -> \Pi (yf : M.E) ->
          M.validN k (M.op a yf) ->
          TruncP (\Sigma (a' : M.E) (M.validN k (M.op a' yf)) (P.upred_holds k a'))
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 k k_le_n2 yf hv =>
      \case incl \with {
        | inP (x3, dist_x2_x1x3) =>
          \let
            | k_le_n1 : k <= n1 => NatSemiring.<=∘ k_le_n2 n2_le_n1
            | dist_x2_x1x3_k : M.dist k x2 (M.op x1 x3) =>
              M.ofe_dist_le n2 k x2 (M.op x1 x3) dist_x2_x1x3 k_le_n2
            | dist_op_yf : M.dist k (M.op x2 yf) (M.op (M.op x1 x3) yf) =>
              M.cmra_op_ne_2 yf k x2 (M.op x1 x3) dist_x2_x1x3_k
            | hv_x1x3_yf : M.validN k (M.op (M.op x1 x3) yf) =>
              M.cmra_validN_ne k (M.op x2 yf) (M.op (M.op x1 x3) yf) dist_op_yf hv
            | hv_x1_x3yf : M.validN k (M.op x1 (M.op x3 yf)) =>
              transport (M.validN k) (inv (M.cmra_assoc x1 x3 yf)) hv_x1x3_yf
            | step => h k k_le_n1 (M.op x3 yf) hv_x1_x3yf
          \in \case step \with {
            | inP (a', hv_a'_x3yf, hp_a') =>
              \let
                | hv_a'x3_yf : M.validN k (M.op (M.op a' x3) yf) =>
                  transport (M.validN k) (M.cmra_assoc a' x3 yf) hv_a'_x3yf
              \in inP (M.op a' x3, hv_a'x3_yf,
                       P.upred_mono k k a' (M.op a' x3) hp_a'
                           (inclN_op_l k a' x3) <=-refl)
          }
      }
